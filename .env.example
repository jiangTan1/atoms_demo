# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。
#
# 这里的 "LLM_*" 指向任意 OpenAI 兼容服务。demo 阶段推荐用完全免费的智谱
# glm-4.5-flash；换成火山方舟（豆包）、DeepSeek、硅基流动等只需改这三个值。
#
# 注意：TraeCode CN 是订阅制 IDE 产品，不对外提供模型 API，无法作为后端模型调用。

# OpenAI 兼容端点地址（需带 /v1、/v4 这类版本路径）
# 智谱：https://open.bigmodel.cn/api/paas/v4
# 火山方舟：https://ark.cn-beijing.volces.com/api/v3
# 硅基流动：https://api.siliconflow.cn/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型标识（以服务商控制台给出的 Model ID 为准）
# 智谱免费模型：glm-4.5-flash
# 火山方舟：doubao-seed-2-1-pro-260628
LLM_MODEL=glm-4.5-flash

# 访问凭据（不要提交到版本库）
LLM_API_KEY=replace-me

# 服务监听地址（默认端口 80；部署时应用只监听 127.0.0.1，公网访问走 Nginx）
# 注意：Linux 上绑定 80 属于特权端口，systemd 单元已授予 CAP_NET_BIND_SERVICE
APP_HOST=127.0.0.1
APP_PORT=80

# 首个管理员的凭据：首次启动且 data/users.db 为空时必须填写，缺失会启动失败并点名配置项
# 账号库非空后这两项可以留空：已创建的管理员不会被覆盖、重置或重建
# 用户名与密码均需 3 到 20 个字符，请使用自己的强口令而不是示例文本
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password

# 会话后端：sqlite（默认，落盘到 data/sessions.db，刷新与重启后仍有历史）或 memory（仅进程内）
SESSION_BACKEND=sqlite

# 会话文件沙箱配额（可选，不填用下面括号内默认值；取值必须为正整数，非法时启动失败）
# 沙箱按会话隔离，落在 data/workspace/<会话ID>/，智能体生成的项目文件写在这里
# 单文件字节上限（默认 262144，即 256 KB）；同时用作读取单文件的上限
WORKSPACE_MAX_FILE_BYTES=262144
# 单会话文件数上限（默认 200）
WORKSPACE_MAX_FILES=200
# 单会话总占用字节上限（默认 10485760，即 10 MB）
WORKSPACE_MAX_TOTAL_BYTES=10485760

# 单会话保留的版本快照上限（可选，默认 20）
# 每轮对话改动沙箱后自动留一个版本，超出上限时按最旧优先清理
VERSION_MAX_PER_SESSION=20

# 登录态 Cookie 是否带 Secure（可选，默认 false）
# false：浏览器在 HTTP 下也会回传 Cookie，便于本机与内网演示
# true：仅在 HTTPS 下回传，部署到 Nginx 终止 TLS 后应置为 true
AUTH_COOKIE_SECURE=false